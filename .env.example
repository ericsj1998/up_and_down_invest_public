# ============================================================
# 환경변수 템플릿 — 키 "이름"만 기록한다. 실제 값은 절대 넣지 않는다.
#
# 실값 파일은 환경별로 분리한다 (spec §12.4 시크릿 네임스페이스 분리):
#   .env.dev    개발     — 조회 전용 키만
#   .env.live   실거래   — live 브로커 키. APP_ENV=live 에서만 로드 가능 (서버에만 둔다)
#   .env.demo   데모 API — 서버에만. 본은 .env.demo.example (라이브 키 없음)
#   (.env.paper 는 2026-09-06 폐기 — 테스트넷 판은 dev 의 api_demo 가 맡는다)
#
# 셋 다 .gitignore 대상이다. 커밋되는 것은 이 파일뿐이다.
# ============================================================

# ── 실행 환경 (필수, 기본값 없음) ─────────────────────────
# dev | paper | live
APP_ENV=

# ── 데이터베이스 / 캐시 ──────────────────────────────────
# 컨테이너 내부에서는 host=postgres, WSL 셸에서는 host=localhost 를 쓴다.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=
REDIS_URL=
# 계정·문의·관리자 설정 표만 다른 DB 에서 열 때 (비면 DATABASE_URL 과 같은 DB). 데모 API 는 compose 가
# 실계좌 DB 를 가리키게 못 박는다 — 실계좌와 데모가 유저 풀을 공유한다 (2026-09-07). 원장·캔들은 자기 DB.
ACCOUNTS_DATABASE_URL=
# DB 커넥션 풀 (T268 #3 · 비면 4/2). 프로세스 셋이 PG max_connections(100)을 넘지 않게 — 데모·계정은 2/1
DB_POOL_SIZE=
DB_MAX_OVERFLOW=

# ── 로깅 ────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── 업비트 (코인) — Phase 0 조회 전용 ─────────────────────
# 주의: 주문 권한 키는 IP 화이트리스트 등록이 필요하다 (spec §8).
#       Phase 0~1 은 조회만 하므로 주문 권한 없는 키를 쓰는 것이 안전하다.
UPBIT_ACCESS_KEY=
UPBIT_SECRET_KEY=

# ── 토스증권 (국내/미국 주식) ────────────────────────────────
#
# 🔴 **이름이 두 벌인 것은 실수가 아니다** (spec §12.4).
#
#   TOSS_CLIENT_*  · TOSS_CERT_*  → **주문** · `.env.live` 에만 · 사용 시점 P2-9
#   TOSS_MARKETDATA_CLIENT_*      → **조회**(캔들·호가) · 조회하는 모든 환경
#
# 왜 나눴나: 백테스트용 과거 캔들을 받으려면 dev/paper 프로세스가 토스를 호출해야
# 하는데, §12.4 격리는 비-live 환경에 `TOSS_CLIENT_*` 가 **있기만 해도** 기동을
# 거부한다. 그 규칙을 푸는 대신 이름을 나눴다 — 규칙은 그대로 살아 있다.
#
# ⛔ 주문용 4개를 .env.dev/.env.paper 에 두지 않는다. **주석 처리도 두는 것이다** —
#    값이 파일에 남아 있고 `#` 하나만 지우면 그 환경이 기동을 거부한다.

# 주문용 — .env.live 전용
# mTLS 인증서 유효기간 390일 → 만료 알림 배치 필수 (spec §2.2, §7)
# (실측: 현 API 버전은 OAuth2 client_credentials 이며 인증서 없이 호출된다.
#  스펙 securitySchemes 에 oauth2ClientCredentials 하나뿐 — docs/toss_api_notes.md §1)
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
TOSS_CERT_PATH=
TOSS_CERT_KEY_PATH=

# 조회용 — 캔들 백필·호가 조회. 값이 주문용과 같은 문자열이어도 무방하다.
# 게이트가 보는 것은 **선언**이고, 이 네임스페이스만 가진 프로세스는 주문 자격증명
# 묶음(`TossCredentials`)을 구성할 수 없다.
TOSS_MARKETDATA_CLIENT_ID=
TOSS_MARKETDATA_CLIENT_SECRET=

# ── DART OpenAPI (펀더멘탈) — 사용 시점 P3-1 ──────────────
DART_API_KEY=

# ── SEC EDGAR (T243 · 미국주식 재무) — 시크릿 아님. SEC 가 요구하는 User-Agent: `이름 이메일`
# 비면 재무 새로고침이 503. https://www.sec.gov/os/accessing-edgar-data
EDGAR_USER_AGENT=

# ── 알림 (P2-5) ─────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_FROM_EMAIL=

# ── 이메일 성과 리포트 (T28) ────────────────────────────
# 일간 리포트 기본 수신자
REPORT_TO=
# 발송 시각 (KST · 정수 시). 저장·스케줄은 UTC 로 변환된다 (규칙 #7).
# ⚠️ 2026-09-06 정정: 코드가 읽는 이름은 `REPORT_HOUR_KST`(Settings.report_hour_kst · 기본 9)다.
#    옛 `REPORT_AT_KST=09:00` 은 어디서도 읽지 않는 죽은 줄이었다 — 세 env 파일 모두 그 이름을 갖고 있었다.
REPORT_HOUR_KST=9

# ── 데드맨 스위치 (P2-5, spec §12.6) — ⏸ 미구현 · 보류 (사용자 결정 2026-09-06) ──
# 읽는 코드가 없다. 외부 핑 서비스 + 리더 핑 코드가 함께 필요해 지금 규모에서는 두지 않는다.
# 실계좌 env 에 이 줄을 두지 않는다 (docs/platform/env_live.md).
# HEARTBEAT_URL=

# ── 테스트 전용 문 (2026-09-02 · 기본 꺼짐 · ⛔ .env.live 금지) ──
# AUTH_TEST_BYPASS=1  → 로컬(127.0.0.1) 요청을 인증 없이 통과 (실계좌면 무시됨)
# WALK_SYNTH_DIR=경로  → 워크 심볼이 SYN 으로 시작하면 이 디렉토리의 합성 캔들을 읽음
# 합성 워크 검증(T202)용. 프로덕션 env 파일에는 절대 두지 않는다.
AUTH_TEST_BYPASS=
WALK_SYNTH_DIR=

# ── 구글 로그인 (2026-08-30 배포 준비) ────────────────────
# 구글 콘솔: API 및 서비스 → 사용자 인증 정보 → OAuth 클라이언트 ID(웹 애플리케이션)
#
# 승인된 리디렉션 URI (여러 개 등록 가능 · 글자까지 같아야 한다):
#     http://localhost:5175/api/auth/callback    ← 컨테이너(make rebuild)
#     http://localhost:5173/api/auth/callback    ← vite(make dev)
#     https://<도메인>/api/auth/callback          ← 배포
#
# ⚠️ localhost 만 http 가 허용된다. localhost 와 127.0.0.1 은 다른 것으로 본다.
# 동의 화면은 게시 상태 **테스트** + 테스트 사용자 등록을 권한다 (문이 하나 더 생긴다).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# 세션 서명 키 — `openssl rand -base64 48`
# ⛔ 비면 로그인이 아예 안 뜬다. 빈 키로 서명하면 누구나 위조하므로,
#    조용히 도는 것보다 안 뜨는 것이 낫다 (절대 규칙 #8).
SESSION_SECRET=

# 첫 관리자 이메일 — 쉼표로 여럿. **처음 로그인할 때만** admin 이 된다.
# 가입 승인을 줄 사람이 최소 한 명은 미리 있어야 한다.
# 보류된 사람의 "관리자 문의" 메일도 여기로 간다 (SMTP_* 설정 시 · 없으면 REPORT_TO · 2026-09-07).
ADMIN_EMAILS=

# ── Gate 실계좌 (T157 · 2026-09-04) — ⛔ .env.live 에만 · 절대 커밋하지 않는다 ──
# 키 권한: Perpetual Futures Read&Write 만 · Withdraw OFF · IP 화이트리스트(Lightsail Static IP)
# 세 줄이 **전부** 있어야 실주문이다. LIVE_ORDERS 가 0 이면 키가 있어도 테스트넷으로 간다.
# 키가 없는데 LIVE_ORDERS=1 이면 어댑터를 얻는 순간 예외다 — 조용히 테스트넷으로 떨어지지 않는다.
GATE_API_KEY=
GATE_API_SECRET=
LIVE_ORDERS=0

# ── 주식 실주문 스위치 (T240 · 2026-09-09) — 코인 LIVE_ORDERS 와 별개 ──
# 0 이면 주식 판(KRX·NASDAQ·NYSE)은 **페이퍼**(토스 시세 + 가상 체결 · DB stock_paper_accounts)로 돈다.
# 1 은 아직 열 수 없다 — 토스 실주문 어댑터가 없어(Secret·인증서 미수령 · G1 뒤) 어댑터를 얻는 순간 예외다.
STOCK_LIVE_ORDERS=0
# 판 시작 한 번의 브로커 요청 상한 (T253 · 0 = 무제한). 폴링 브로커(토스)만 센다
RUN_START_REQUEST_CAP=300
