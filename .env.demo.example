# ── 데모 API 전용 env (T221 Demo Trading · 2026-09-05) ─────────────────────────
# 서버의 ~/updown/.env.demo 로 복사해 값을 채운다. compose.live.yml 의 api_demo/migrate_demo 가 읽는다.
#
# 🔴 여기에는 **라이브 키(GATE_API_KEY/SECRET)를 절대 넣지 않는다.** APP_ENV=paper 프로세스는 라이브 키가
#    보이기만 해도 기동을 거부한다(config.py) — 그것이 격리의 근거다.
# ⚠️ APP_ENV · DATABASE_URL · REDIS_URL · LIVE_ORDERS · UPDOWN_MARKETS 는 compose 의 environment 가 못 박는다.
#    여기 적어도 무시된다.

# 테스트넷 키 (데모 판이 실제로 주문을 내는 곳 · 페이크머니). testnet.gate.com → API 관리. IP 화이트리스트 = 서버 Static IP.
GATE_TESTNET_API_KEY=
GATE_TESTNET_API_SECRET=

# 구글 로그인 — 실계좌와 **같은 값**. 리디렉션 URI 도 같다 (nginx 가 쿠키로 갈라 보내므로 경로가 하나다).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# 🔴 세션 서명 키 — 실계좌와 **같은 값**이어야 한다. 그래야 로그인한 사람이 Demo Trading 스위치로 오갈 때
#    같은 쿠키가 양쪽에서 읽힌다. (게스트 쪽지는 실계좌 서버가 이메일로 걸러 낸다.)
SESSION_SECRET=
# 첫 관리자 — 실계좌와 같게. 계정·등급 표는 2026-09-07 부터 실계좌 DB 것을 **함께 쓴다**
# (compose 의 ACCOUNTS_DATABASE_URL). "데모 거래만" 은 관리자 화면의 데모 거래 토글.
ADMIN_EMAILS=

LOG_LEVEL=INFO
# SMTP 는 비워 둔다 — 데모는 메일을 보내지 않는다 (보내기 단추가 "SMTP 설정 없음" 으로 꺼진다).
