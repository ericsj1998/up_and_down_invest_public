# 외부 공개용 TLS 앞단 (2026-08-30 배포 준비).
#
# ## 왜 Caddy 인가
#
# Let's Encrypt 인증서를 **알아서 받고 알아서 갱신한다.** certbot + cron + nginx 설정을
# 손으로 엮는 것보다 움직이는 부품이 적고, 갱신을 깜빡해 만료되는 사고가 없다.
#
# ⚠️ 인증서를 받으려면 이 서버의 **80·443 이 도메인으로 열려 있어야** 한다.
#    (Let's Encrypt 가 그 주소로 되찾아온다.) 공유기를 쓰면 포트 포워딩이 필요하다.
#
# ## 🔴 이 파일이 지키는 한 가지
#
# 뒤의 API 는 `X-Forwarded-Proto` 를 보고 세션 쿠키에 `Secure` 를 붙일지 정한다.
# 그 헤더가 없거나 `http` 면 **로그인 자체를 거부한다** (`auth._secure`).
# Caddy 는 `reverse_proxy` 에서 이 헤더를 자동으로 넘긴다 — 손댈 것이 없다.
#
# ⛔ 이 앞단을 다른 것으로 바꾸면 그 헤더를 **직접 챙겨야 한다.** 안 넘기면
#    배포 뒤 로그인이 통째로 안 되고, 그것이 조용히 취약한 것보다 낫다.

{
	# 인증서 만료 안내를 받을 주소. ⚠️ 비면 Let's Encrypt 가 거절할 수 있다.
	email {$ACME_EMAIL}
}

# 도메인은 환경변수로 받는다 — 파일에 박으면 이 저장소가 특정 도메인에 묶인다.
{$PUBLIC_DOMAIN} {
	encode zstd gzip

	# 🔴 HSTS 는 **여기서만** 붙인다. 개발(평문 localhost)에 붙으면 브라우저가
	#    그 호스트를 기억해 다른 프로젝트까지 https 로 강제한다.
	#
	# ⚠️ `preload` 는 넣지 않았다 — 목록에 오르면 **빼는 데 몇 달**이 걸린다.
	#    도메인 운영이 안정된 뒤에 사람이 판단할 일이다.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}

	# 화면 컨테이너로 넘긴다. `/api/` 를 떼는 일은 그 안의 nginx 가 한다 —
	# 여기서 또 떼면 두 곳이 같은 규칙을 들고 있게 된다.
	reverse_proxy web:80
}
